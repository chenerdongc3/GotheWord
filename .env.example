NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# PostHog browser configuration. Copy the token and host from the selected
# project; do not guess the US/EU region.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_browser_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-region.i.posthog.com

# Release correlation attached to every custom analytics event.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_RELEASE_SHA=local
NEXT_PUBLIC_DEPLOYMENT_ENV=local
NEXT_PUBLIC_SITES_VERSION=unavailable
NEXT_PUBLIC_SUPABASE_MIGRATION=20260727000000

# Public provider key used by pencil-pup-ui BotChallenge. The matching secret
# is only configured in Supabase Auth and must never use a NEXT_PUBLIC_ name.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Supabase CLI/Auth deployment environment (server-only). Use distinct site
# and redirect URLs for local, preview, staging, and production deployments.
GOTHEWORD_AUTH_SITE_URL=http://localhost:3000
GOTHEWORD_AUTH_REDIRECT_URL=http://localhost:3000
GOTHEWORD_SMTP_HOST=smtp.example.com
GOTHEWORD_SMTP_USER=your_smtp_user
GOTHEWORD_SMTP_PASS=your_smtp_password
GOTHEWORD_SMTP_FROM=auth@example.com
GOTHEWORD_TURNSTILE_SECRET=your_turnstile_secret

# The register Edge Function uses the server-side equivalents below as
# Supabase Function secrets, not as browser variables:
# POSTHOG_PROJECT_TOKEN
# POSTHOG_HOST
# APP_VERSION
# RELEASE_SHA
# DEPLOYMENT_ENV
# SITES_VERSION
# SUPABASE_MIGRATION
