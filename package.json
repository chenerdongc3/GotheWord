{
  "name": "gotheword",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run release:manifest && npm run content:a1:prepare",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "npm run content:a1:bundle",
    "build:pages": "npm run release:manifest && npm run content:a1:prepare && GITHUB_PAGES=true NEXT_PUBLIC_SITE_URL=https://chenerdongc3.github.io/GotheWord WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && npm run content:a1:bundle",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/a1-content.test.mjs tests/learning.test.mjs tests/learning-sync.test.mjs tests/analytics.test.mjs tests/release-metadata.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/a1-content.test.mjs tests/learning.test.mjs tests/learning-sync.test.mjs tests/analytics.test.mjs tests/release-metadata.test.mjs",
    "test:analytics": "playwright test tests/analytics.spec.ts",
    "test:mobile": "playwright test tests/mobile.spec.ts",
    "test:pages": "npm run build:pages && node --test tests/pages-export.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern .wrangler --ignore-pattern tmp",
    "release:manifest": "node scripts/release-metadata.mjs",
    "release:verify": "node scripts/release-metadata.mjs --verify",
    "content:a1:generate": "node --experimental-strip-types scripts/generate-a1-runtime.mjs",
    "content:a1:validate": "node --experimental-strip-types scripts/validate-a1-content.mjs",
    "content:a1:report": "node --experimental-strip-types scripts/report-a1-coverage.mjs",
    "content:a1:prepare": "npm run content:a1:generate && npm run content:a1:validate && npm run content:a1:report",
    "content:a1:check": "npm run content:a1:validate && node --experimental-strip-types scripts/generate-a1-runtime.mjs --check",
    "content:a1:bundle": "node --experimental-strip-types scripts/check-a1-bundle.mjs",
    "content:a1:check-rights": "node --experimental-strip-types scripts/check-a1-rights.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "animal-island-ui": "^1.2.3",
    "next": "16.2.6",
    "posthog-js": "^1.407.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
