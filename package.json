{
  "name": "gotheword",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/verified-build.mjs",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_SITE_URL=https://chenerdongc3.github.io/GotheWord node scripts/verified-build.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:integration",
    "test:mobile": "npm run test:e2e -- tests/e2e/mobile.spec.ts",
    "test:pages": "npm run build:pages && node --test tests/pages-export.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:integration": "npm run test:ssr:unconfigured && npm run test:ssr:configured && node --test tests/integration/supabase-contract.test.mjs",
    "test:ssr:unconfigured": "NEXT_PUBLIC_SUPABASE_URL='' NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY='' npm run build && TEST_EXPECT_SUPABASE=unconfigured node --test tests/integration/rendered-html.test.mjs",
    "test:ssr:configured": "NEXT_PUBLIC_SUPABASE_URL='https://integration-test.supabase.co' NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY='integration-test-publishable-key' npm run build && TEST_EXPECT_SUPABASE=configured node --test tests/integration/rendered-html.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "animal-island-ui": "^1.2.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
